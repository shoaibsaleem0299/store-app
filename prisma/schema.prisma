generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       BigInt     @id @default(autoincrement())
  name     String
  parentId BigInt?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Product {
  id          BigInt       @id @default(autoincrement())
  name        String
  description String?
  categoryId  BigInt?      @map("category_id")
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       String?
  baseImages  Json         @default("[]") @map("base_images")
  status      String       @default("active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  optionTypes OptionType[]
  variants    Variant[]

  @@map("products")
}

model OptionType {
  id           BigInt        @id @default(autoincrement())
  productId    BigInt?       @map("product_id")
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int           @default(0) @map("display_order")
  optionValues OptionValue[]

  @@map("option_types")
}

model OptionValue {
  id                  BigInt                @id @default(autoincrement())
  optionTypeId        BigInt?               @map("option_type_id")
  optionType          OptionType?           @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  value               String
  swatchImage         String?               @map("swatch_image")
  displayOrder        Int                   @default(0) @map("display_order")
  variantOptionValues VariantOptionValue[]

  @@map("option_values")
}

model Variant {
  id                  BigInt                @id @default(autoincrement())
  productId           BigInt?               @map("product_id")
  product             Product?              @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode             String                @unique @map("sku_code")
  price               Decimal               @db.Decimal(10, 2)
  promoPrice          Decimal?              @map("promo_price") @db.Decimal(10, 2)
  stockQty            Int                   @default(0) @map("stock_qty")
  imageUrl            String?               @map("image_url")
  isActive            Boolean               @default(true) @map("is_active")
  variantOptionValues VariantOptionValue[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@map("variants")
}

model VariantOptionValue {
  variantId     BigInt      @map("variant_id")
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId BigInt      @map("option_value_id")
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model CartItem {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  variantId BigInt?  @map("variant_id")
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)

  @@unique([userId, variantId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId         String?     @map("buyer_id") @db.Uuid
  status          String      @default("pending")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingAddress Json?       @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  orderItems      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        BigInt   @id @default(autoincrement())
  orderId   String?  @map("order_id") @db.Uuid
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId BigInt?  @map("variant_id")
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)

  @@map("order_items")
}

model Profile {
  id        String   @id @db.Uuid
  email     String
  password  String?
  fullName  String?  @map("full_name")
  role      String   @default("customer")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("profiles")
}
